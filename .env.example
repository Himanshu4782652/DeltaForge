# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Encryption Key for Multi-Demat Broker Vault (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_SECRET_KEY=your-32-byte-base64-encoded-fernet-key-here=

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=deltaforge_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0

# FastAPI Engine Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001
FASTAPI_URL=http://127.0.0.1:8001

# Broker API Sandbox / Endpoints (Optional for testing)
ZERODHA_API_BASE=https://api.kite.trade
DHAN_API_BASE=https://api.dhan.co
ANGEL_API_BASE=https://apiconnect.angelone.in
